{
  "name": "Dentist WhatsApp Intent Workflow (Simple)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "intent-webhook-simple",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-node-simple",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8001/turn",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"message\": \"Vou confirmar minha consulta\", \"whatsapp_number\": \"5546999887766\"}",
        "options": {}
      },
      "id": "http-request-node-simple",
      "name": "Process Turn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $json;\nreturn [{ json: { ok: true, intent: payload.intent, reply_text: payload.reply_text, can_assert_facts: payload.can_assert_facts } }];"
      },
      "id": "set-node-simple",
      "name": "Set Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Process Turn",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Turn": {
      "main": [
        [
          {
            "node": "Set Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "fase-1-turn-simple"
