      "typeVersion": 2,
      "position": [300, 300],
      "webhookId": "030caabc-8949-4ba5-b67d-d361d492fa08"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/turn",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.body.message, whatsapp_number: $json.body.from || $json.body.whatsapp_number }) }}",
        "options": {}
      },
      "id": "http-request-node",
      "name": "Process Turn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json;\nconst canAssert = payload.can_assert_facts === true;\nconst reply = payload.reply_text || '';\nconst escalation = payload.escalation || { needed: false, reason: null };\nreturn [{ json: {\n  intent: payload.intent || 'UNKNOWN',\n  confidence: payload.confidence || 'medium',\n  unit_hypothesis: payload.unit_hypothesis || null,\n  presence_evidence: payload.presence_evidence || 'missing',\n  availability_evidence: payload.availability_evidence || 'missing',\n  allowed_claims: payload.allowed_claims || {},\n  escalation,\n  can_assert_facts: canAssert,\n  reply_text: reply,\n  next: canAssert ? 'respond' : (escalation.needed ? 'handoff' : 'ask')\n} }];"
      },
      "id": "set-node",
      "name": "Grounded Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
