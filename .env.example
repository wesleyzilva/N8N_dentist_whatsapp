# n8n basic auth
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Host / Webhook
N8N_HOST=localhost
WEBHOOK_URL=https://your-public-url.example.com/webhook

# Postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n

# Google OAuth2 / calendários por unidade (Fase 3)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-public-url.example.com/rest/oauth2-credential/callback
GOOGLE_CALENDAR_PATO_BRANCO=REPLACE_CALENDAR_PATO_BRANCO
GOOGLE_CALENDAR_SAO_CARLOS=REPLACE_CALENDAR_SAO_CARLOS

# LLM
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai

# WhatsApp
WHATSAPP_API_URL=https://api.whatsapp-provider.example/messages
WHATSAPP_API_TOKEN=your_whatsapp_token

# Timezone
TZ=America/Sao_Paulo

# Serviço Python (Fase 1)
PORT=8001

# Evolution API (WhatsApp). Gere uma chave nova e forte; a antiga esteve no git e deve ser tratada como vazada.
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_CORS_ORIGIN=http://localhost:5678
EVOLUTION_API_URL=http://localhost:8080

# Gemini (opcional; usado só como fallback do classificador legado e no teste de conexão do TPM Console)
GEMINI_API_KEY=
