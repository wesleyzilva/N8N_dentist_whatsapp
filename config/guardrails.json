{
  "default_intent": "UNKNOWN",
  "guardrails": {
    "tone": "humano, empático e claro",
    "avoid": [
      "mensagens longas",
      "tom agressivo",
      "pressão indevida",
      "inventar horário",
      "inventar cidade da doutora",
      "inventar procedimento ou preço",
      "falar como consultório odontológico geral",
      "dar conselho clínico ou diagnóstico"
    ],
    "required_words": [
      "atendimento",
      "agendamento",
      "confirmação"
    ],
    "grounding": {
      "never_invent": [
        "availability_slots",
        "doctor_presence_city",
        "address",
        "price",
        "procedure_details",
        "clinical_advice"
      ],
      "on_missing_evidence": "ask_or_escalate",
      "ddd_is_hypothesis_not_presence": true
    },
    "fallback_message": "Olá! Posso te ajudar com o atendimento de harmonização orofacial. Se quiser, me diz se é para confirmar, reagendar, cancelar ou ver horário — e em qual cidade (Pato Branco ou São Carlos).",
    "clinical_escalate_keywords": [
      "dor",
      "emergencia",
      "emergência",
      "sangramento",
      "inchaco",
      "inchaço",
      "urgente",
      "desmaio"
    ]
  },
  "intent_examples": {
    "CONFIRM": [
      "Vou confirmar minha consulta",
      "Vou confirmar meu procedimento",
      "Sim, estarei presente"
    ],
    "RESCHEDULE": [
      "Preciso reagendar para outro dia",
      "Quero trocar de horário"
    ],
    "CANCEL": [
      "Quero cancelar",
      "Não vou comparecer"
    ],
    "QUESTION": [
      "Tenho uma dúvida",
      "Como funciona a consulta?",
      "Vocês fazem harmonização orofacial?"
    ],
    "AVAILABILITY": [
      "Tem horário essa semana",
      "Quero ver disponibilidade"
    ],
    "LOCATION": [
      "A dra está em Pato Branco",
      "Atende em São Carlos hoje"
    ],
    "UNKNOWN": [
      "Olá",
      "Não sei responder"
    ]
  }
}
