# Copie para .env e preencha. NÃO versione o .env.

POSTGRES_USER=clinica_admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Banco interno do n8n. O banco da clínica ("clinica") é criado pelos scripts em db/init
POSTGRES_DB=n8n

# Gere uma nova com: openssl rand -hex 32
# Se você já tem um n8n com credenciais salvas, use a chave dele (veja o README)
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
# Em produção/testes com WhatsApp, use a URL pública (túnel ou domínio)
WEBHOOK_URL=http://localhost:5678/
